// 背景canvas
#universe
  position fixed
  top 0
  left 0
  width 100%
  height 100%
  background: radial-gradient(1600px at 70% 120%, rgba(33, 39, 80, 1) 10%, #020409 100%);
  z-index -1
  //background-image: url('/themes/Fan/source/images/Background.jpg'); /* 使用本地图片作为背景 */
  //background-size: cover; /* 确保背景图片覆盖整个元素 */
  //background-position: center; /* 将背景图片居中 */
  //z-index: -1; /* 将元素堆叠顺序设置为负数，放置在普通内容的下面 */
  //filter: brightness(0.7); /* 设置亮度为70% */
//#body
//  display flex
//  flex-direction row
//  height 100%
#main-container
  //flex 1 1 auto
  height 100%

// 内容
#content-outer
  height calc(100% - 98px)
  overflow auto
  #content-inner
    margin 32px auto
    width 900px
    // 为右下角常驻音乐播放器预留空间，避免遮挡分页
    padding-bottom 140px

// 页脚
#bottom-outer
  #bottom-inner
    color $color-font

// 返回顶部
#return-top
  opacity 0
  position fixed
  bottom 148px
  right 32px
  width 40px
  height 40px
  line-height 40px
  text-align center
  font-size 16px
  color $color-font
  cursor pointer
  z-index 9
  transform all 0.8s
  &:hover
    transform scale(1.5)