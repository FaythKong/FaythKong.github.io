// 常驻音乐播放器，位于 #main-container 之外，pjax 切换页面时不会被替换
#music-player
  position fixed
  right 32px
  bottom 20px
  z-index 20
  width 300px
  max-width calc(100vw - 32px)
  border-radius 6px
  overflow hidden
  background rgba(0, 0, 0, 0.45)
  box-shadow 0 2px 12px $box-shadow-color
  .music-player-bar
    display flex
    align-items center
    height 32px
    padding 0 10px
    font-size 13px
    color $color-white
    background $rgba-color
    cursor pointer
    user-select none
    .music-player-icon
      margin-right 6px
      color $color-theme
    .music-player-title
      flex 1
      overflow hidden
      white-space nowrap
      text-overflow ellipsis
    .music-player-toggle
      transition $transition-delay
  .music-player-body
    // 播放器整体 300x120：标题栏 32px + 播放区 88px
    height 88px
    overflow hidden
    iframe
      display block
      width 100%
      height 100%
      border none
  &.collapsed
    .music-player-body
      display none
    .music-player-bar .music-player-toggle
      transform rotate(180deg)
