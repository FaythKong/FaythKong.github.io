// 小屏下的常驻音乐播放器，尺寸使用 px，避免主题根字号随视口缩放导致播放器被放大
#music-player
  position fixed
  right 16px
  bottom 20px
  z-index 20
  width 300px
  max-width calc(100vw - 32px)
  border-radius 6px
  overflow hidden
  background rgba(0, 0, 0, 0.45)
  box-shadow 0 2px 12px $box-shadow-color
  .music-player-bar
    display flex
    align-items center
    height 32px
    padding 0 10px
    font-size 13px
    color $color-white
    background $rgba-color
    cursor pointer
    user-select none
    .music-player-icon
      margin-right 6px
      color $color-theme
    .music-player-title
      flex 1
      overflow hidden
      white-space nowrap
      text-overflow ellipsis
    .music-player-toggle
      transition $transition-delay
  .music-player-body
    height auto
    iframe
      display block
      width 100%
      border none
  &.collapsed
    .music-player-body
      display none
    .music-player-bar .music-player-toggle
      transform rotate(180deg)