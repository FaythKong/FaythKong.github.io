- var music = theme.music || {}
if music.enable
    - var playerType = music.type === 'playlist' ? 0 : 2
    //- height 参数只决定网易云播放器样式（66 迷你 / 86 完整），实际内容需要约 86px 高
    - var playerStyle = music.mini === false ? 86 : 66
    - var playerAuto = music.autoplay === false ? 0 : 1
    - var playerSrc = 'https://music.163.com/outchain/player?type=' + playerType + '&id=' + music.id + '&auto=' + playerAuto + '&height=' + playerStyle
    //- lives outside #content-inner and #sidebar so pjax navigation never reloads it
    #music-player
        .music-player-bar
            i.fas.fa-music.music-player-icon(aria-hidden="true")
            span.music-player-title= music.title || _p('music.title')
            i.fas.fa-angle-down.music-player-toggle(aria-hidden="true")
        .music-player-body
            iframe(
                frameborder="no"
                border="0"
                marginwidth="0"
                marginheight="0"
                width="100%"
                height="88"
                src=playerSrc
                allow="autoplay"
            )
